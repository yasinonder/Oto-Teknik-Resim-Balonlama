<Window x:Class="WAT.DrawingInspector.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WAT Teknik Resim Balonlama" Height="850" Width="1400"
 WindowStartupLocation="CenterScreen" Background="#F3F6F8">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#173746" Padding="14">
   <DockPanel>
    <TextBlock Text="WAT MOTOR A.Ş. | TEKNİK RESİM BALONLAMA" Foreground="White"
     FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Resim Aç" Click="Open_Click" Margin="4" Padding="16,8"/>
     <Button Content="OCR + Konum" Click="Ocr_Click" Margin="4" Padding="16,8"/>
     <Button Content="OCR Alanlarını Temizle" Click="ClearOcr_Click" Margin="4" Padding="16,8"/>
     <Button Content="Balonları Temizle" Click="Clear_Click" Margin="4" Padding="16,8"/>
     <Button Content="CSV Dışa Aktar" Click="Export_Click" Margin="4" Padding="16,8"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="8">
   <TextBlock x:Name="StatusText" Text="Hazır. Teknik resim açın; manuel balon eklemek için resim üzerinde tıklayın."/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DCE4E8">
    <Grid x:Name="DrawingSurface" Background="#DCE4E8" MouseLeftButtonDown="Surface_Click">
     <Image x:Name="DrawingImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
     <Canvas x:Name="OcrCanvas" IsHitTestVisible="False"/>
     <Canvas x:Name="BalloonCanvas" IsHitTestVisible="False"/>
    </Grid>
   </ScrollViewer>
   <Border Grid.Column="1" Background="White" BorderBrush="#D7E0E5" BorderThickness="1" Padding="12">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="BALON LİSTESİ" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
     <ListView x:Name="BalloonList">
      <ListView.View><GridView>
       <GridViewColumn Header="No" DisplayMemberBinding="{Binding Number}" Width="45"/>
       <GridViewColumn Header="X (px)" DisplayMemberBinding="{Binding X}" Width="85"/>
       <GridViewColumn Header="Y (px)" DisplayMemberBinding="{Binding Y}" Width="85"/>
      </GridView></ListView.View>
     </ListView>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>