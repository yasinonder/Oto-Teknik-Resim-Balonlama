<Window x:Class="WAT.DrawingInspector.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WAT Teknik Resim Balonlama" Height="900" Width="1540" MinWidth="1200"
 WindowStartupLocation="CenterScreen" Background="#F3F6F8">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#173746" Padding="12">
   <DockPanel LastChildFill="True">
    <TextBlock Text="WAT MOTOR A.Ş. | TEKNİK RESİM BALONLAMA" Foreground="White"
     FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="OpenButton" Content="Teknik Resim Aç" Click="Open_Click" Margin="3" Padding="12,7"/>
     <Button Content="Proje Aç" Click="OpenProject_Click" Margin="3" Padding="10,7"/>
     <Button Content="Projeyi Kaydet" Click="SaveProject_Click" Margin="3" Padding="10,7"/>
     <Button x:Name="PdfPrevButton" Content="◀ Önceki" Click="PdfPrevious_Click" Margin="3" Padding="10,7" IsEnabled="False"/>
     <TextBlock x:Name="PdfPageText" Text="PDF yok" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
     <Button x:Name="PdfNextButton" Content="Sonraki ▶" Click="PdfNext_Click" Margin="3" Padding="10,7" IsEnabled="False"/>
     <Button x:Name="OcrButton" Content="OCR + Konum" Click="Ocr_Click" Margin="3" Padding="12,7" IsEnabled="False"/>
     <Button Content="OCR Alanlarını Temizle" Click="ClearOcr_Click" Margin="3" Padding="10,7"/>
     <Button Content="Balonları Temizle" Click="Clear_Click" Margin="3" Padding="10,7"/>
     <Button Content="CSV Dışa Aktar" Click="Export_Click" Margin="3" Padding="10,7"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="8">
   <TextBlock x:Name="StatusText" Text="Hazır. PDF, DXF veya görsel açın; manuel balon eklemek için çizim üzerinde tıklayın."/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DCE4E8">
    <Grid x:Name="DrawingSurface" Background="#DCE4E8" MouseLeftButtonDown="Surface_Click">
     <Image x:Name="DrawingImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
     <Canvas x:Name="OcrCanvas" IsHitTestVisible="False"/>
     <Canvas x:Name="BalloonCanvas" IsHitTestVisible="True"/>
    </Grid>
   </ScrollViewer>
   <Border Grid.Column="1" Background="White" BorderBrush="#D7E0E5" BorderThickness="1" Padding="12">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="BALON LİSTESİ" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
      <Button Content="Seçili Balonu Sil" Click="DeleteSelectedBalloon_Click"
       HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>
     </StackPanel>
     <ListView x:Name="BalloonList" SelectionChanged="BalloonList_SelectionChanged"
      Height="190" MinHeight="150" Margin="0,0,0,10">
      <ListView.View><GridView>
       <GridViewColumn Header="No" DisplayMemberBinding="{Binding Number}" Width="35"/>
       <GridViewColumn Header="Özellik" DisplayMemberBinding="{Binding Characteristic}" Width="105"/>
       <GridViewColumn Header="Sonuç" DisplayMemberBinding="{Binding Result}" Width="80"/>
      </GridView></ListView.View>
     </ListView>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="ÖLÇÜM VE TOLERANS" FontWeight="Bold" FontSize="15"
        Margin="0,2,0,8"/>
       <TextBlock Text="Karakteristik / ölçü adı" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="CharacteristicTextBox" Margin="0,3,0,8" Padding="6"/>
       <TextBlock Text="Nominal değer" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="NominalValueTextBox" Margin="0,3,0,8" Padding="6"/>
       <TextBlock Text="Alt tolerans / sapma (örn. -0,10)" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="LowerToleranceTextBox" Margin="0,3,0,8" Padding="6"/>
       <TextBlock Text="Üst tolerans / sapma (örn. +0,10)" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="UpperToleranceTextBox" Margin="0,3,0,8" Padding="6"/>
       <TextBlock Text="Ölçülen değer" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="MeasuredValueTextBox" Margin="0,3,0,8" Padding="6"/>
       <TextBlock x:Name="MeasurementResultText" Text="Sonuç: Beklemede"
        FontWeight="Bold" Foreground="#52616B" Margin="0,2,0,8"/>
       <TextBlock Text="Notlar" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="NotesTextBox" Margin="0,3,0,8" Padding="6"
        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58"
        VerticalScrollBarVisibility="Auto"/>
       <Button Content="Ölçü Bilgilerini Uygula" Click="ApplyMeasurement_Click"
        Padding="10,8" Margin="0,4,0,8" Background="#173746" Foreground="White"/>
       <TextBlock Text="Bilgi: Alt ve üst toleranslar nominal değere eklenen işaretli sapmalardır."
        FontSize="11" Foreground="#6B7880" TextWrapping="Wrap" Margin="0,0,0,8"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>