<Window x:Class="WAT.DrawingInspector.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WAT Teknik Resim Balonlama" Height="950" Width="1740" MinWidth="1320"
 WindowStartupLocation="CenterScreen" Background="#F3F6F8">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#173746" Padding="8">
   <DockPanel LastChildFill="True">
    <TextBlock Text="WAT MOTOR A.Ş. | TEKNİK RESİM BALONLAMA" Foreground="White"
     FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="OpenButton" Content="Teknik Resim Aç" Click="Open_Click" Margin="3" Padding="10,6"/>
     <Button Content="Proje Aç" Click="OpenProject_Click" Margin="3" Padding="9,6"/>
     <Button Content="Projeyi Kaydet" Click="SaveProject_Click" Margin="3" Padding="9,6"/>
     <Button x:Name="PdfPrevButton" Content="◀ Önceki" Click="PdfPrevious_Click" Margin="3" Padding="9,6" IsEnabled="False"/>
     <TextBlock x:Name="PdfPageText" Text="PDF yok" Foreground="White" VerticalAlignment="Center" Margin="6,0"/>
     <Button x:Name="PdfNextButton" Content="Sonraki ▶" Click="PdfNext_Click" Margin="3" Padding="9,6" IsEnabled="False"/>
     <Button x:Name="OcrButton" Content="Ölçüleri Tara" Click="Ocr_Click" Margin="3" Padding="10,6" IsEnabled="False"/>
     <Button Content="OCR Alanlarını Temizle" Click="ClearOcr_Click" Margin="3" Padding="9,6"/>
     <Button Content="Balonları Temizle" Click="Clear_Click" Margin="3" Padding="9,6"/>
     <Button Content="Raporu Düzenle" Click="EditReport_Click" Margin="3" Padding="9,6"/>
     <Button Content="Excel Raporu" Click="ExportExcel_Click" Margin="3" Padding="9,6"/>
     <Button Content="PDF Raporu" Click="ExportPdf_Click" Margin="3" Padding="9,6"/>
     <Button Content="CSV Dışa Aktar" Click="Export_Click" Margin="3" Padding="9,6"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="8">
   <TextBlock x:Name="StatusText" Text="Hazır. PDF, DXF veya görsel açın; çizim alanında tıklayarak balon ekleyin."/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="410" MinWidth="370"/>
   </Grid.ColumnDefinitions>

   <DockPanel Grid.Column="0" LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#E8EEF1" Padding="5" BorderBrush="#CCD7DD" BorderThickness="0,0,0,1">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="ÇİZİM GÖRÜNÜMÜ" FontWeight="Bold" Foreground="#294552" VerticalAlignment="Center" Margin="5,0,14,0"/>
      <Button Content="−" Click="ZoomOut_Click" Width="34" Padding="5,3" Margin="2"/>
      <Button Content="+" Click="ZoomIn_Click" Width="34" Padding="5,3" Margin="2"/>
      <TextBlock x:Name="ZoomLevelText" Text="%100" Width="55" TextAlignment="Center" VerticalAlignment="Center"/>
      <Button Content="Ekrana Sığdır" Click="FitDrawing_Click" Padding="9,3" Margin="2"/>
      <Button Content="Gerçek Boyut" Click="ActualSize_Click" Padding="9,3" Margin="2"/>
      <TextBlock Text="Ctrl + fare tekerleği: yakınlaştır / uzaklaştır" Foreground="#657780" VerticalAlignment="Center" Margin="14,0,0,0"/>
     </StackPanel>
    </Border>
    <ScrollViewer x:Name="ZoomScrollViewer" HorizontalScrollBarVisibility="Auto"
     VerticalScrollBarVisibility="Auto" Background="#DCE4E8" PreviewMouseWheel="ZoomScrollViewer_PreviewMouseWheel">
     <Grid x:Name="DrawingSurface" Background="#DCE4E8"
      MouseLeftButtonDown="Surface_Click" MouseMove="Surface_MouseMove"
      MouseLeftButtonUp="Surface_MouseLeftButtonUp">
      <Image x:Name="DrawingImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <Canvas x:Name="DimensionLinkCanvas" IsHitTestVisible="False"/>
      <Canvas x:Name="OcrCanvas" IsHitTestVisible="False"/>
      <Canvas x:Name="BalloonCanvas" IsHitTestVisible="True"/>
     </Grid>
    </ScrollViewer>
   </DockPanel>

   <Border Grid.Column="1" Background="White" BorderBrush="#D7E0E5" BorderThickness="1" Padding="12">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="BALON VE ÖLÇÜM YÖNETİMİ" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
      <Button Content="Ölçü Alanı Seç (çizimde sürükle)" Click="BeginDimensionAreaSelection_Click"
       Padding="9,7" Margin="0,0,0,8" Background="#E8F1F5"/>
      <TextBlock Text="OCR yalnızca ölçü adayı kutularını gösterir. Notlar ve açıklamalar otomatik balonlanmaz."
       FontSize="11" Foreground="#657780" TextWrapping="Wrap" Margin="0,0,0,8"/>
     </StackPanel>

     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="BALON LİSTESİ" FontWeight="Bold" FontSize="13" Margin="0,2,0,5"/>
       <ListView x:Name="BalloonList" SelectionChanged="BalloonList_SelectionChanged"
        Height="140" MinHeight="100" Margin="0,0,0,6">
        <ListView.View><GridView>
         <GridViewColumn Header="No" DisplayMemberBinding="{Binding Number}" Width="35"/>
         <GridViewColumn Header="Ölçü" DisplayMemberBinding="{Binding DimensionText}" Width="120"/>
         <GridViewColumn Header="Özellik" DisplayMemberBinding="{Binding Characteristic}" Width="100"/>
         <GridViewColumn Header="Sonuç" DisplayMemberBinding="{Binding Result}" Width="75"/>
        </GridView></ListView.View>
       </ListView>
       <Button Content="Seçili Balonu Sil" Click="DeleteSelectedBalloon_Click"
        HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,10"/>

       <TextBlock Text="BULUNAN ÖLÇÜ ADAYLARI" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
       <ListView x:Name="DimensionCandidateList" Height="145" MinHeight="90"
        SelectionMode="Single" Margin="0,0,0,6">
        <ListView.View><GridView>
         <GridViewColumn Header="Çizimden okunan" DisplayMemberBinding="{Binding OcrText}" Width="150"/>
         <GridViewColumn Header="Nominal" DisplayMemberBinding="{Binding SuggestedValue}" Width="65"/>
         <GridViewColumn Header="Tol." DisplayMemberBinding="{Binding SuggestedTolerance}" Width="48"/>
         <GridViewColumn Header="Güven" DisplayMemberBinding="{Binding ConfidenceText}" Width="48"/>
        </GridView></ListView.View>
       </ListView>
       <Button Content="Seçili Ölçüyü Balona Bağla / Yeni Balon" Click="AddSelectedDimensionCandidate_Click"
        Padding="8,7" Margin="0,0,0,12" Background="#173746" Foreground="White"/>

       <TextBlock Text="SEÇİLİ BALONUN ÖLÇÜ BİLGİSİ" FontWeight="Bold" FontSize="14" Margin="0,0,0,7"/>
       <TextBlock Text="Çizimden okunan orijinal ölçü" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="DimensionTextBox" Margin="0,3,0,8" Padding="6" IsReadOnly="True"
        Background="#F0F4F6" TextWrapping="Wrap" MinHeight="34"/>
       <TextBlock Text="Karakteristik / ölçü adı" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="CharacteristicTextBox" Margin="0,3,0,7" Padding="6"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,4,0">
         <TextBlock Text="Nominal" FontSize="12" Foreground="#52616B"/>
         <TextBox x:Name="NominalValueTextBox" Margin="0,3,0,7" Padding="6"/>
         <TextBlock Text="Alt tolerans (−)" FontSize="12" Foreground="#52616B"/>
         <TextBox x:Name="LowerToleranceTextBox" Margin="0,3,0,7" Padding="6"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="4,0,0,0">
         <TextBlock Text="Ölçülen değer" FontSize="12" Foreground="#52616B"/>
         <TextBox x:Name="MeasuredValueTextBox" Margin="0,3,0,7" Padding="6"/>
         <TextBlock Text="Üst tolerans (+)" FontSize="12" Foreground="#52616B"/>
         <TextBox x:Name="UpperToleranceTextBox" Margin="0,3,0,7" Padding="6"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="MeasurementResultText" Text="Sonuç: Beklemede"
        FontWeight="Bold" Foreground="#52616B" Margin="0,2,0,8"/>
       <TextBlock Text="Notlar" FontSize="12" Foreground="#52616B"/>
       <TextBox x:Name="NotesTextBox" Margin="0,3,0,8" Padding="6"
        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"
        VerticalScrollBarVisibility="Auto"/>
       <Button Content="Ölçü Bilgilerini Uygula" Click="ApplyMeasurement_Click"
        Padding="10,8" Margin="0,4,0,8" Background="#173746" Foreground="White"/>
       <TextBlock Text="Alt/üst toleranslar nominale eklenen işaretli sapmalardır. Örnek: −0,10 / +0,10."
        FontSize="11" Foreground="#6B7880" TextWrapping="Wrap" Margin="0,0,0,8"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
